    },
    "volume_growth": {
      "dist": "ci90",
      "low": 0.2,
      "high": 0.9
    },
    "value_per_k": {
      "dist": "ci90",
      "low": 5,
      "high": 12,
      "kind": "lognormal"
    },
    "api_price": {
      "dist": "ci90",
      "low": 2.0,
      "high": 5.0,
      "kind": "lognormal"
    },
    "api_price_drift": {
      "dist": "uniform",
      "low": -0.3,
      "high": 0.0
    },
    "platform_fee": {
      "dist": "uniform",
      "low": 9000,
      "high": 16000
    },
    "platform_uplift": {
      "dist": "triangular",
      "low": 0.03,
      "mode": 0.08,
      "high": 0.15
    },
    "build_months": {
      "dist": "triangular",
      "low": 5,
      "mode": 7,
      "high": 12
